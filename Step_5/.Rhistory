```{r}
all_data %>%
filter(status == "CLOSED") %>%
group_by(repo, rule) %>%
summarise(count = n()) %>%
mutate(rank = rank(-count, ties.method = "random")) %>%
filter(rank <= 10) %>%
group_by(repo, rank) %>%
mutate(rule_count = paste(rule, " - ", count)) %>%
select(repo, rule_count, rank) %>%
pivot_wider(names_from = repo, values_from = rule_count) %>%
arrange(rank)
